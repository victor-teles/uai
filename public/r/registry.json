{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "uai",
  "homepage": "http://localhost:3000",
  "items": [
    {
      "name": "uai-theme",
      "type": "registry:theme",
      "title": "Uai Theme",
      "description": "The graphite surface and state-color tokens used by Uai components.",
      "cssVars": {
        "light": {
          "uai-canvas": "oklch(0.975 0.002 255)",
          "uai-surface": "oklch(1 0 0)",
          "uai-surface-raised": "oklch(0.955 0.003 255)",
          "uai-border": "oklch(0.88 0.006 255)",
          "uai-border-strong": "oklch(0.76 0.01 255)",
          "uai-text": "oklch(0.19 0.008 255)",
          "uai-muted": "oklch(0.48 0.012 255)",
          "uai-accent": "oklch(0.56 0.19 257)",
          "uai-accent-foreground": "oklch(0.99 0 0)",
          "uai-success": "oklch(0.65 0.18 145)",
          "uai-warning": "oklch(0.69 0.15 83)",
          "uai-danger": "oklch(0.64 0.21 27)"
        },
        "dark": {
          "uai-canvas": "oklch(0.145 0.006 255)",
          "uai-surface": "oklch(0.19 0.007 255)",
          "uai-surface-raised": "oklch(0.225 0.008 255)",
          "uai-border": "oklch(0.29 0.01 255)",
          "uai-border-strong": "oklch(0.4 0.012 255)",
          "uai-text": "oklch(0.965 0.003 255)",
          "uai-muted": "oklch(0.68 0.012 255)",
          "uai-accent": "oklch(0.64 0.19 257)",
          "uai-accent-foreground": "oklch(0.99 0 0)",
          "uai-success": "oklch(0.72 0.18 145)",
          "uai-warning": "oklch(0.77 0.15 83)",
          "uai-danger": "oklch(0.7 0.19 27)"
        }
      },
      "categories": ["theme"]
    },
    {
      "name": "uai-utils",
      "type": "registry:lib",
      "title": "Uai Utilities",
      "description": "A small class-name merge utility shared by Uai components.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/registry/uai/lib/uai-utils.ts",
          "type": "registry:lib",
          "target": "@lib/uai-utils.ts"
        }
      ],
      "categories": ["utility"]
    },
