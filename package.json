{
  "name": "uai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://uaiblocks.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-teles/uai.git"
  },
  "bugs": {
    "url": "https://github.com/victor-teles/uai/issues"
  },
  "type": "module",
  "scripts": {
    "build": "bun run registry:build && next build --webpack",
    "dev": "bun run registry:build && next dev --webpack",
    "format": "biome format --write .",
    "lint": "biome check .",
    "registry:build": "shadcn build registry.json",
    "registry:check": "bun scripts/registry-check.ts",
    "consumer:check": "bun scripts/consumer-check.ts",
    "og:capture": "bun scripts/og-capture.ts",
    "start": "next start",
    "test": "bun run registry:build && bun test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.14.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.3",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.7",
    "@happy-dom/global-registrator": "^20.11.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "latest",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.25",
    "shadcn": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
